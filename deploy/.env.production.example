# OREP production environment example.
# Copy to /opt/orep/deploy/.env.production on the server and fill real secrets.
# Do not commit the real .env.production file.

DOMAIN=www.jingsaidanao.com
PUBLIC_IP=你的服务器公网IP
TZ=Asia/Shanghai
OREP_STORAGE_ROOT=/data/orep-storage

MYSQL_ROOT_PASSWORD=请改成强密码
MYSQL_DATABASE=orep

REDIS_PASSWORD=请改成强密码

JWT_SECRET=请改成至少64位随机字符串
JAVA_OPTS="-Xms512m -Xmx1200m -XX:+UseG1GC"

LIVEKIT_API_KEY=orep-prod-key
LIVEKIT_API_SECRET=请改成至少32位随机字符串
LIVEKIT_WS_URL=wss://www.jingsaidanao.com/livekit
LIVE_CAMERA_SUBSCRIBER_ENABLED=false

RECORDING_BOT_SECRET=请改成随机字符串

MINIO_ROOT_USER=orepminio
MINIO_ROOT_PASSWORD=请改成强密码
MINIO_BUCKET_RECORDINGS=meeting-recordings

SPRING_MAIL_HOST=smtp.qq.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=你的邮箱
SPRING_MAIL_PASSWORD=你的邮箱授权码
OREP_EMAIL_FROM=你的邮箱
OREP_EMAIL_PYTHON_FALLBACK_ENABLED=false
OREP_EMAIL_PYTHON_BIN=python3
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=false
SPRING_MAIL_SMTP_SSL_ENABLE=true
SPRING_MAIL_SMTP_SSL_PROTOCOLS="TLSv1.3 TLSv1.2"
SPRING_MAIL_SMTP_SSL_TRUST=smtp.qq.com
SPRING_MAIL_SMTP_SSL_CHECK_SERVER_IDENTITY=false
SPRING_MAIL_SMTP_SOCKET_FACTORY_CLASS=javax.net.ssl.SSLSocketFactory
SPRING_MAIL_SMTP_SOCKET_FACTORY_PORT=465
SPRING_MAIL_SMTP_SOCKET_FACTORY_FALLBACK=false
SPRING_MAIL_SMTP_CONNECTION_TIMEOUT=10000
SPRING_MAIL_SMTP_TIMEOUT=10000
SPRING_MAIL_SMTP_WRITE_TIMEOUT=10000

DASHSCOPE_API_KEY=你的阿里云百炼DashScopeKey
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
MINIMAX_API_KEY=你的MiniMaxKey
MINIMAX_BASE_URL=https://api.minimax.chat/v1

PPT_TEXT_API_KEY=你的PPT文本模型Key
PPT_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PPT_TEXT_MODEL=qwen3.6-plus
PPT_HTML_API_KEY=你的PPT_HTML模型Key
PPT_HTML_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PPT_HTML_MODEL=qwen3-coder-plus
PPT_VISION_API_KEY=你的PPT视觉模型Key
PPT_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PPT_VISION_MODEL=qwen3.6-plus
DEFAULT_MODEL=qwen3.6-plus

IMAGE2_API_KEY=你的Image2图片生成Key
IMAGE2_BASE_URL=https://img.alibaba.cv
IMAGE2_MODEL=gpt-image-2
IMAGE2_API_PROTOCOL=auto
IMAGE2_RESOLUTION=2K
IMAGE2_EXPORT_MODE=image
IMAGE2_RETRY_ATTEMPTS=3
IMAGE2_RETRY_BASE_DELAY=1.5
IMAGE2_TIMEOUT_SECONDS=300

AI_JURY_ENABLED=true
AI_JURY_PROVIDERS=deepseek
AI_JURY_COUNT=9
AI_JURY_MAX_WORKERS=9
AI_JURY_MEMBER_TIMEOUT_SECONDS=180

# Backend calls AI scoring via Docker service name in release compose.
# Local non-docker default is http://127.0.0.1:8090 (see application.yml).
# AI_SCORING_BASE_URL=http://ai-scoring:8090
