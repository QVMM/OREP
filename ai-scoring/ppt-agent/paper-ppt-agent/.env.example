# Server
HOST=0.0.0.0
PORT=8000

# Default LLM provider (mimo / qwen / openai / deepseek / anthropic / gemini)
DEFAULT_LLM_PROVIDER=mimo
DEFAULT_LLM_MODEL=mimo-v2.5-pro

# API Keys (provide at least one)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1/chat/completions
MIMO_MODEL=mimo-v2.5-pro
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.6-plus
QWEN_VISION_MODEL=qwen3-vl-flash
PPT_IMAGE_MODEL=qwen-image-2.0-pro
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Paper parsing (optional: MinerU for high-fidelity PDF parsing)
MINERU_API_KEY=
MINERU_API_URL=

# Image generation (optional)
IMAGE_BACKEND=gemini
IMAGE2_API_KEY=
IMAGE2_BASE_URL=https://img.alibaba.cv
IMAGE2_MODEL=gpt-image-2
IMAGE2_API_PROTOCOL=auto
IMAGE2_RESOLUTION=2K
IMAGE2_EXPORT_MODE=image
IMAGE2_RETRY_ATTEMPTS=3
IMAGE2_RETRY_BASE_DELAY=1.5
IMAGE2_TIMEOUT_SECONDS=300
