<script setup>
import { onMounted, onUnmounted, ref } from 'vue'
import { useRouter } from 'vue-router'
import homeImage from '../assets/intro/competition-brain-home-real.webp'
import trainingImage from '../assets/intro/competition-brain-training-real.webp'
import scoreImage from '../assets/intro/competition-brain-score-real.webp'
import pptImage from '../assets/intro/competition-brain-ppt-real.webp'

const router = useRouter()
const activeSection = ref('value')
let observer
let scrollAnimationFrame
let pointerAnimationFrame
let introScroller
let handlePointerMove

onMounted(() => {
  const blocks = Array.from(document.querySelectorAll('.reveal-block'))
  observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return
      entry.target.classList.add('is-visible')
      if (entry.target.id) activeSection.value = entry.target.id
    })
  }, { threshold: 0.18, rootMargin: '0px 0px -10% 0px' })
  blocks.forEach((block) => observer.observe(block))

  introScroller = document.querySelector('.linear-intro')
  handlePointerMove = (event) => {
    if (!introScroller || pointerAnimationFrame) return
    pointerAnimationFrame = requestAnimationFrame(() => {
      const rect = introScroller.getBoundingClientRect()
      const x = ((event.clientX - rect.left) / rect.width) * 100
      const y = ((event.clientY - rect.top) / rect.height) * 100
      introScroller.style.setProperty('--intro-pointer-x', `${Math.max(0, Math.min(100, x)).toFixed(2)}%`)
      introScroller.style.setProperty('--intro-pointer-y', `${Math.max(0, Math.min(100, y)).toFixed(2)}%`)
      pointerAnimationFrame = null
    })
  }
  introScroller?.addEventListener('pointermove', handlePointerMove, { passive: true })

  const initialSection = window.location.hash.replace('#', '')
  if (initialSection) {
    requestAnimationFrame(() => scrollToSection(initialSection, false))
  }
})

onUnmounted(() => {
  observer?.disconnect()
  if (scrollAnimationFrame) cancelAnimationFrame(scrollAnimationFrame)
  if (pointerAnimationFrame) cancelAnimationFrame(pointerAnimationFrame)
  if (introScroller && handlePointerMove) {
    introScroller.removeEventListener('pointermove', handlePointerMove)
  }
})

function go(path) {
  router.push(path)
}

function scrollToSection(sectionId, syncHash = false) {
  const scroller = document.querySelector('.linear-intro')
  const target = document.getElementById(sectionId)
  if (!scroller || !target) return

  const headerHeight = document.querySelector('.intro-header')?.offsetHeight || 72
  const targetTop = Math.max(target.offsetTop - headerHeight - 12, 0)
  activeSection.value = sectionId
  document.querySelectorAll('.reveal-block').forEach((block) => {
    if (block.offsetTop <= target.offsetTop + window.innerHeight) {
      block.classList.add('is-visible', 'is-nav-visible')
    }
  })
  animateIntroScroll(scroller, targetTop)

  if (syncHash) {
    window.history.replaceState(null, '', `${window.location.pathname}#${sectionId}`)
  }

  window.setTimeout(() => {
    document.querySelectorAll('.reveal-block.is-nav-visible').forEach((block) => {
      block.classList.remove('is-nav-visible')
    })
  }, 900)
}

function animateIntroScroll(scroller, targetTop) {
  if (scrollAnimationFrame) cancelAnimationFrame(scrollAnimationFrame)

  const startTop = scroller.scrollTop
  const distance = targetTop - startTop
  if (Math.abs(distance) < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    scroller.scrollTop = targetTop
    return
  }

  const duration = Math.min(820, Math.max(460, Math.abs(distance) * 0.32))
  const startTime = performance.now()
  const easeOutQuint = (progress) => 1 - Math.pow(1 - progress, 5)

  const step = (now) => {
    const progress = Math.min((now - startTime) / duration, 1)
    scroller.scrollTop = startTop + distance * easeOutQuint(progress)

    if (progress < 1) {
      scrollAnimationFrame = requestAnimationFrame(step)
    } else {
      scrollAnimationFrame = null
    }
  }

  scrollAnimationFrame = requestAnimationFrame(step)
}
</script>

