.creation-section {
  padding: 140px 0 130px;
  background: #f6f7f9;
}

.creation-heading {
  max-width: 790px;
  margin-inline: auto;
  text-align: center;
}

.creation-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 60px;
}

.creation-card {
  min-width: 0;
  padding: 30px;
  overflow: hidden;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
}

.creation-card-head {
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
}

.creation-icon {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  color: var(--orange);
  background: var(--surface-orange);
  border-radius: 13px;
}

.creation-icon svg {
  width: 21px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.7;
}

.creation-card-head small,
.creation-card-head h3 {
  display: block;
}

.creation-card-head small { color: var(--muted); font-size: 9px; }
.creation-card-head h3 { margin-top: 2px; font-size: 19px; }
.creation-card-head em { padding: 6px 9px; color: var(--orange); background: var(--surface-orange); border-radius: 99px; font-size: 8px; font-style: normal; font-weight: 650; }

.creation-card > p {
  margin-top: 20px;
  color: var(--ink-soft);
  font-size: 13px;
  line-height: 1.8;
}

.slide-stack {
  position: relative;
  height: 285px;
  margin-top: 26px;
}

.slide-back,
.slide-mid,
.slide-front {
  position: absolute;
  overflow: hidden;
  border-radius: 17px;
}

.slide-back {
  inset: 30px 42px 0;
  background: #e8eaed;
  transform: rotate(-5deg);
}

.slide-mid {
  inset: 20px 28px 7px;
  background: #f0d8cf;
  transform: rotate(4deg);
}

.slide-front {
  inset: 0 18px 20px;
  padding: 28px;
  color: var(--paper);
  background:
    radial-gradient(circle at 83% 25%, rgba(255, 255, 255, .17), transparent 24%),
    linear-gradient(145deg, #2b1b16, #141313 62%, #3a1b12);
  box-shadow: 0 18px 35px rgba(29, 25, 23, .2);
}

.slide-no {
  color: #c8b6af;
  font-size: 9px;
}

.slide-front strong {
  display: block;
  margin-top: 30px;
  font-size: 29px;
  letter-spacing: -.05em;
  line-height: 1.2;
}

.slide-chart {
  display: flex;
  height: 70px;
  align-items: end;
  gap: 8px;
  margin-top: 26px;
}

.slide-chart i {
  width: 20px;
  background: var(--orange-soft);
  border-radius: 4px 4px 0 0;
}

.slide-chart i:nth-child(1) { height: 32%; opacity: .4; }
.slide-chart i:nth-child(2) { height: 48%; opacity: .58; }
.slide-chart i:nth-child(3) { height: 70%; opacity: .76; }
.slide-chart i:nth-child(4) { height: 96%; }
.slide-front small { position: absolute; right: 26px; bottom: 25px; color: #b9aaa4; font-size: 9px; }

.slide-comment {
  position: absolute;
  right: 0;
  bottom: 6px;
  padding: 8px 10px;
  color: var(--orange);
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 9px;
  box-shadow: 0 10px 24px rgba(30, 37, 44, .12);
  font-size: 8px;
  font-weight: 700;
}

.script-sheet {
  height: 285px;
  margin-top: 26px;
  padding: 22px;
  background: #fbfaf8;
  border: 1px solid #e8e3de;
  border-radius: 17px;
}

.script-person {
  display: grid;
  grid-template-columns: 32px minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  padding-bottom: 14px;
  border-bottom: 1px solid #e7e1dc;
}

.script-person .avatar {
  width: 32px;
  height: 32px;
  color: #86533e;
  background: #efdcd2;
}

.script-person strong { font-size: 10px; }
.script-person em { color: var(--muted); font-size: 8px; font-style: normal; }

.script-sheet > p {
  position: relative;
  margin-top: 18px;
  padding-left: 41px;
  color: #555a61;
  font-size: 11px;
  line-height: 1.75;
}

.script-sheet > p i {
  position: absolute;
  top: 1px;
  left: 0;
  color: #9ba0a7;
  font-size: 8px;
  font-style: normal;
}

.script-sheet > p.is-highlighted {
  padding: 10px 10px 10px 41px;
  background: var(--surface-orange);
  border-radius: 8px;
}

.script-sheet > p.is-highlighted i {
  top: 11px;
  left: 8px;
  color: var(--orange);
}

.script-comment {
  margin: 12px 0 0 41px;
  padding: 9px 11px;
  color: #725c52;
  background: #f3e8e2;
  border-left: 2px solid var(--orange);
  border-radius: 0 7px 7px 0;
  font-size: 8px;
  line-height: 1.5;
}

.script-comment b { margin-right: 5px; color: var(--orange); }

.creation-features {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 18px;
}

.creation-features span {
  padding: 7px 10px;
  color: #686f78;
  background: #f4f5f6;
  border-radius: 99px;
  font-size: 9px;
}

.training-note {
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) auto;
  align-items: center;
  gap: 16px;
  margin-top: 20px;
  padding: 24px 28px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
}

.training-mark {
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  color: var(--orange);
  background: var(--surface-orange);
  border-radius: 14px;
}

.training-mark svg {
  width: 24px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.7;
}

.training-note span,
.training-note strong {
  display: block;
}

.training-note div > span { color: var(--orange); font-size: 9px; font-weight: 720; }
.training-note div > strong { margin-top: 5px; font-size: 15px; }
.training-note > a { color: #555c65; font-size: 11px; font-weight: 650; }
.training-note > a span { display: inline; margin-left: 4px; color: var(--orange); }

.final-cta {
  position: relative;
  display: grid;
  min-height: 670px;
  place-items: center;
  overflow: hidden;
  color: var(--paper);
  background:
    radial-gradient(circle at 50% 45%, rgba(255, 255, 255, .15), transparent 36%),
    linear-gradient(145deg, #ff7249, var(--orange) 48%, #c82f06);
  text-align: center;
}

.final-cta::before {
  position: absolute;
  inset: 0;
  content: "";
  opacity: .12;
  background-image: radial-gradient(circle, #fff 1px, transparent 1px);
  background-size: 26px 26px;
  mask-image: radial-gradient(circle, #000, transparent 68%);
}

.final-orbit {
  position: absolute;
  border: 1px solid rgba(255, 255, 255, .22);
  border-radius: 50%;
}

.orbit-a { width: 640px; height: 640px; }
.orbit-b { width: 930px; height: 390px; transform: rotate(-12deg); }

.final-content {
  position: relative;
  z-index: 2;
  width: min(780px, calc(100% - 40px));
}

.final-logo {
  display: grid;
  width: 64px;
  height: 64px;
  margin: 0 auto 22px;
  place-items: center;
  background: var(--paper);
  border-radius: 20px;
  box-shadow: 0 15px 32px rgba(91, 27, 7, .2);
}

.final-logo img { width: 43px; height: 43px; }
.final-content > p { opacity: .72; font-size: 10px; font-weight: 720; letter-spacing: .22em; }

.final-content h2 {
  margin-top: 20px;
  font-size: clamp(48px, 6.2vw, 82px);
  font-weight: 740;
  letter-spacing: -.07em;
  line-height: 1.04;
}

.final-content > span {
  display: block;
  max-width: 590px;
  margin: 24px auto 0;
  color: rgba(255, 255, 255, .78);
  font-size: 15px;
  line-height: 1.8;
}

.final-content > a {
  display: inline-flex;
  min-height: 54px;
  align-items: center;
  gap: 24px;
  margin-top: 30px;
  padding: 0 23px;
  color: var(--ink);
  background: var(--paper);
  border-radius: 999px;
  font-size: 13px;
  font-weight: 720;
  box-shadow: 0 16px 32px rgba(91, 27, 7, .18);
  transition: transform 200ms var(--ease);
}

.final-content > a:hover { transform: translateY(-3px); }
.final-content > a b { color: var(--orange); font-size: 18px; }

.site-footer {
  background: #101114;
  color: var(--paper);
}

.footer-inner {
  display: grid;
  width: min(1180px, calc(100% - 48px));
  min-height: 150px;
  margin-inline: auto;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 32px;
}

.footer-brand .brand-mark {
  background: #1d2024;
  border-color: #30343a;
  box-shadow: none;
}

.footer-inner > p {
  color: #7e848d;
  font-size: 10px;
}

.footer-links {
  display: flex;
  gap: 24px;
  color: #a5abb3;
  font-size: 10px;
}

.footer-links a:hover { color: var(--paper); }

.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 680ms var(--ease), transform 680ms var(--ease);
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

