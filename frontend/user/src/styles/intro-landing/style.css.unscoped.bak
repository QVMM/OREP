:root {
  --ink: #101114;
  --ink-soft: #565d68;
  --muted: #8c929c;
  --line: #e7e9ed;
  --line-strong: #d9dde3;
  --paper: #ffffff;
  --surface: #f6f7f9;
  --surface-blue: #f3f8fc;
  --surface-warm: #fff7f2;
  --surface-orange: #fff0e8;
  --orange: #e84a1c;
  --orange-dark: #c93a10;
  --orange-soft: #ff815c;
  --green: #20a46b;
  --blue: #4788e8;
  --yellow: #eeb94f;
  --radius-sm: 10px;
  --radius-md: 18px;
  --radius-lg: 28px;
  --radius-xl: 38px;
  --shadow-window: 0 35px 90px rgba(29, 42, 57, .14), 0 8px 24px rgba(29, 42, 57, .08);
  --shadow-soft: 0 18px 50px rgba(25, 31, 38, .08);
  --font: "Avenir Next", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  --ease: cubic-bezier(.22, 1, .36, 1);
}

* {
  box-sizing: border-box;
}

/* Scoped by landing page container to avoid fighting the Vue app shell. */
.landing-page {
  color: var(--ink);
  background: var(--paper);
  font-family: var(--font);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body.menu-open {
  overflow: hidden;
}

button,
a,
input {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  color: inherit;
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

button:focus-visible,
a:focus-visible {
  outline: 3px solid rgba(232, 74, 28, .34);
  outline-offset: 3px;
}

img,
svg {
  display: block;
}

h1,
h2,
h3,
p {
  margin: 0;
  text-wrap: pretty;
}

.skip-link {
  position: fixed;
  z-index: 200;
  top: 14px;
  left: 14px;
  padding: 10px 14px;
  color: var(--paper);
  background: var(--ink);
  border-radius: 8px;
  transform: translateY(-150%);
  transition: transform 180ms ease;
}

.skip-link:focus {
  transform: translateY(0);
}

.section-shell {
  width: min(1180px, calc(100% - 48px));
  margin-inline: auto;
}

.site-header {
  position: absolute;
  z-index: 50;
  top: 0;
  left: 0;
  width: 100%;
  height: 92px;
  color: var(--ink);
}

.site-header.is-scrolled {
  position: fixed;
  height: 72px;
  background: rgba(255, 255, 255, .9);
  border-bottom: 1px solid rgba(16, 17, 20, .07);
  backdrop-filter: blur(18px);
  animation: header-in 260ms ease both;
}

@keyframes header-in {
  from { transform: translateY(-100%); }
  to { transform: translateY(0); }
}

.nav-shell {
  width: min(1180px, calc(100% - 48px));
  height: 100%;
  margin-inline: auto;
  display: flex;
  align-items: center;
  gap: 32px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 19px;
  font-weight: 720;
  letter-spacing: -.03em;
}

.brand-mark {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  overflow: hidden;
  background: var(--paper);
  border: 1px solid rgba(16, 17, 20, .08);
  border-radius: 10px;
  box-shadow: 0 6px 16px rgba(31, 45, 60, .08);
}

.brand-mark img {
  width: 23px;
  height: 23px;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 38px;
  margin-left: auto;
}

.desktop-nav a {
  position: relative;
  padding-block: 8px;
  color: #34383f;
  font-size: 14px;
  font-weight: 520;
}

.desktop-nav a::after {
  position: absolute;
  right: 0;
  bottom: 2px;
  left: 0;
  height: 1.5px;
  content: "";
  background: var(--orange);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 220ms ease;
}

.desktop-nav a:hover::after,
.desktop-nav a.is-active::after {
  transform: scaleX(1);
  transform-origin: left;
}

.nav-entry {
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  justify-content: center;
  padding: 0 19px;
  color: var(--paper);
  background: var(--ink);
  border-radius: 999px;
  font-size: 13px;
  font-weight: 650;
  transition: transform 180ms ease, background-color 180ms ease;
}

.nav-entry:hover {
  background: var(--orange);
  transform: translateY(-2px);
}

.menu-toggle {
  display: none;
  width: 42px;
  height: 42px;
  margin-left: auto;
  padding: 0;
  border: 0;
  background: transparent;
}

.menu-toggle span {
  display: block;
  width: 20px;
  height: 1.5px;
  margin: 6px auto;
  background: currentColor;
  transition: transform 220ms ease;
}

.menu-toggle[aria-expanded="true"] span:first-child {
  transform: translateY(3.75px) rotate(45deg);
}

.menu-toggle[aria-expanded="true"] span:last-child {
  transform: translateY(-3.75px) rotate(-45deg);
}

.mobile-menu {
  position: fixed;
  z-index: 49;
  inset: 72px 0 auto;
  padding: 18px 24px 28px;
  background: rgba(255, 255, 255, .98);
  border-bottom: 1px solid var(--line);
  box-shadow: 0 18px 50px rgba(20, 27, 34, .1);
}

.mobile-menu a {
  display: block;
  padding: 15px 4px;
  border-bottom: 1px solid var(--line);
  font-size: 16px;
  font-weight: 620;
}

.hero {
  position: relative;
  min-height: 1110px;
  padding-top: 123px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 3%, rgba(255, 255, 255, .95) 0, rgba(255, 255, 255, 0) 30%),
    linear-gradient(180deg, #f0f8fd 0%, #f6f9fb 48%, #fff9f5 100%);
}

.hero::after {
  position: absolute;
  z-index: 0;
  bottom: -220px;
  left: 50%;
  width: 960px;
  height: 580px;
  content: "";
  background: radial-gradient(ellipse, rgba(232, 74, 28, .12), rgba(232, 74, 28, 0) 68%);
  transform: translateX(-50%);
  pointer-events: none;
}

.hero-glow {
  position: absolute;
  top: 120px;
  left: 50%;
  width: 460px;
  height: 460px;
  background: radial-gradient(circle, rgba(255, 255, 255, .9), rgba(255, 255, 255, 0) 70%);
  transform: translateX(-50%);
  pointer-events: none;
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: min(910px, calc(100% - 40px));
  margin-inline: auto;
  text-align: center;
}

.hero-logo {
  display: grid;
  width: 68px;
  height: 68px;
  margin: 0 auto 22px;
  place-items: center;
  background: var(--paper);
  border: 1px solid rgba(16, 17, 20, .07);
  border-radius: 21px;
  box-shadow: 0 15px 32px rgba(35, 61, 79, .14);
}

.hero-logo img {
  width: 45px;
  height: 45px;
}

.eyebrow,
.section-kicker {
  color: var(--orange);
  font-size: 12px;
  font-weight: 760;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.hero h1 {
  margin-top: 14px;
  font-size: clamp(48px, 5.3vw, 76px);
  font-weight: 760;
  letter-spacing: -.065em;
  line-height: 1.08;
}

.hero-description {
  width: min(720px, 100%);
  margin: 23px auto 0;
  color: #666d77;
  font-size: 17px;
  line-height: 1.85;
}

.primary-cta,
button.primary-cta {
  display: inline-flex;
  min-height: 52px;
  align-items: center;
  justify-content: center;
  gap: 9px;
  margin-top: 28px;
  padding: 0 25px;
  border: 0;
  color: var(--paper);
  background: linear-gradient(135deg, var(--orange-soft), var(--orange));
  border-radius: 999px;
  box-shadow: 0 14px 28px rgba(232, 74, 28, .25);
  font-size: 15px;
  font-weight: 700;
  transition: transform 200ms var(--ease), box-shadow 200ms ease;
}

.primary-cta svg {
  width: 18px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.8;
  transition: transform 200ms ease;
}

.primary-cta:hover {
  box-shadow: 0 18px 34px rgba(232, 74, 28, .32);
  transform: translateY(-3px);
}

.primary-cta:hover svg {
  transform: translateX(3px);
}

.hero-note {
  margin-top: 13px;
  color: #9aa0a9;
  font-size: 11px;
}
